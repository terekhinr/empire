# /config/secrets.yaml — скопировать на HA. Рабочая цепочка (docs/HA_MVP_SETUP.md):
#   HA → 172.30.32.1:8766 (empire-ha-proxy на armbian) → VPS :8877 → Telegram
#
# Токен = HA_NOTIFY_TOKEN из /opt/empire-ha-bridge/.env или empire-ha-proxy

ha_notify_url: "http://172.30.32.1:8766/notify"
ha_notify_token: "Bearer ***REMOVED***"

# Если gateway другой: docker inspect homeassistant --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}'
# Проверка: docker exec homeassistant curl -s -m 5 http://172.30.32.1:8766/health

# Прямо на VPS (если proxy не нужен):
# ha_notify_url: "http://100.84.19.35:8877/notify"

# Teckin TC100 (RTSP hack, см. scripts/teckin-tc100/README.md):
teckin_camera_password: "pass"
# ezviz_username: "your@email.ru"
# ezviz_password: "your_password"
# ezviz_url: apirus.ezvizru.com
# ezviz_cam_bf0241992: "XXXXXX"   # код с наклейки камеры BF0241992 (улица)
# ezviz_cam_bf5488322: "XXXXXX"   # код с наклейки камеры BF5488322 (подъезд)
