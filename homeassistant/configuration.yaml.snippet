# Добавить в /config/configuration.yaml (один раз):

homeassistant:
  packages: !include_dir_named packages

frontend:
  themes: !include_dir_merge_named themes

# Yandex Smart Home — список устройств для Алисы (см. docs/HA_YANDEX_ALICE_SETUP.md)
yandex_smart_home: !include yandex_smart_home.yaml

