# =========================================================================
# Конфигурация для всех сайтов медиаимперии.
# Канонические домены:
#   neverretire.ru  → FastAPI на 127.0.0.1:8000 (web_app.py, проект "Пенсия")
#   gdepar.ru       → FastAPI на 127.0.0.1:8001 (gdepar_app.py, проект "Где Пар")
#
# Все зеркала редиректят (301) на канонические домены.
# HTTP→HTTPS редирект делается только если запрос НЕ идёт через HTTPS-прокси
# (т.е. X-Forwarded-Proto ≠ "https"). Это нужно, чтобы Cloudflare в режиме
# "Flexible SSL" не зацикливал редиректы.
#
# HTTPS сертификаты — Let's Encrypt через certbot:
#   sudo certbot certonly --webroot -w /var/www/certbot \
#       -d neverretire.ru -d www.neverretire.ru \
#       -d napensiyunikogda.ru -d www.napensiyunikogda.ru \
#       -d xn--80aaiedsaqwcbog4a0r.xn--p1ai
#   sudo certbot certonly --webroot -w /var/www/certbot \
#       -d gdepar.ru -d www.gdepar.ru \
#       -d xn--80afde4ch.xn--p1ai
# (после выпуска — раскомментировать соответствующие 443 server-блоки ниже)
# =========================================================================

# Признак "запрос уже через HTTPS" — либо порт 443, либо CF прислал
# X-Forwarded-Proto: https. Используется для условного редиректа.
map $http_x_forwarded_proto $is_https_request {
    default 0;
    "https" 1;
}

# -------------------- 1. NEVERRETIRE.RU — основной сайт --------------------
server {
    listen 80;
    listen [::]:80;
    server_name neverretire.ru www.neverretire.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Редирект на HTTPS только если запрос НЕ от Cloudflare HTTPS (Flexible mode).
    # Иначе будет петля: CF→origin по HTTP → 301 → CF возвращает 301 пользователю → ...
    location / {
        if ($is_https_request = 0) {
            return 301 https://$host$request_uri;
        }
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    include /root/projects/empire/deploy/nginx/neverretire_dashboard.inc;

    location /static/ {
        alias /root/projects/empire/static/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name neverretire.ru www.neverretire.ru;

    ssl_certificate /etc/letsencrypt/live/neverretire.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/neverretire.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    include /root/projects/empire/deploy/nginx/neverretire_dashboard.inc;

    location /static/ {
        alias /root/projects/empire/static/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
}

