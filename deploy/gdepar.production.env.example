# Пример prod-переменных для gdepar.ru
# На сервере: sudo mkdir -p /etc/empire && sudo cp deploy/gdepar.production.env.example /etc/empire/gdepar.env && sudo chmod 600 /etc/empire/gdepar.env
# Дублирует OPENROUTER_API_KEY / DATABASE_URL из основного .env при необходимости.

GDEPAR_CANONICAL_HOST=gdepar.ru
GDEPAR_WEB_PORT=8001
GDEPAR_ASSET_VERSION=20260520b

# Метрика (только цифры счётчика; цели — см. .env.example)
YANDEX_METRIKA_ID=

# HTTPS: HSTS на ответах приложения (при прокси с X-Forwarded-Proto: https)
GDEPAR_HSTS_MAX_AGE=31536000

# Помощник «Пар?» — LLM при OPENROUTER_API_KEY в .env + GDEPAR_ASSISTANT_LLM=1
# OPENROUTER_API_KEY=   # обычно уже в /root/projects/empire/.env
# Продуктовое решение: частичный rollout (см. ТЗ §7)
GDEPAR_ASSISTANT_LLM=1
GDEPAR_ASSISTANT_LLM_PCT=25
GDEPAR_ASSISTANT_CACHE_SECONDS=3600
GDEPAR_ASSISTANT_RL_PER_MIN=24

# Саммари «Дай саммари» — LLM через OpenRouter (при ошибке — эвристика)
GDEPAR_POPUP_SUMMARY_LLM=1
GDEPAR_POPUP_SUMMARY_LLM_PCT=100

# Админка бань (cookie) — тот же токен, что BANYA_ADMIN_TOKEN в .env
# BANYA_ADMIN_TOKEN=
