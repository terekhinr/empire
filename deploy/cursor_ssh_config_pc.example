# Cursor Remote SSH — Empire VPS (после cutover 2026-10-14)
Host empire-vps
    HostName 45.146.88.222
    User root
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 30
    ServerAliveCountMax 20
    TCPKeepAlive yes
    ConnectTimeout 60

# Tailscale — после tailscale up на NEW подставьте 100.x
# Host empire-vps-ts
#     HostName 100.x.x.x
#     User root
#     IdentityFile ~/.ssh/id_ed25519
#     IdentitiesOnly yes

Host empire-vps-old-rkn
    HostName 138.124.90.47
    User root
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
