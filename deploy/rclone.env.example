# Скопировать: sudo cp deploy/rclone.env.example /etc/empire/rclone.env && sudo chmod 600 /etc/empire/rclone.env
# Пароль приложения: https://id.yandex.ru/security/app-passwords

YANDEX_DISK_USER="your@yandex.ru"
YANDEX_DISK_APP_PASSWORD="app-password-here"

# Пути на Диске (как в веб-интерфейсе, от корня Диска)
RCLONE_VAULT_REMOTE_PATH="obsidian (2)"
OBSIDIAN_VAULT_ROOT=/root/projects/empire/data/obsidian_vault
RCLONE_REMOTE_PATH="obsidian (2)/Empire"
RCLONE_BACKUP_REMOTE_PATH="VPS-backup"
