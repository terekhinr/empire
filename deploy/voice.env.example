# /etc/empire/voice.env
#
# Рекомендуется: gdrive — телефон → Google Drive → VPS (ПК не нужен)
#   Один раз: sudo bash scripts/rclone_connect_gdrive_oauth.sh
#
# Запасной: yandex — ПК копирует в Life/voice/raw на Яндекс.Диске

VOICE_SOURCE=gdrive
VOICE_GDRIVE_REMOTE=gdrive
VOICE_GDRIVE_PATH="Easy Voice Recorder"
YANDEX_VAULT_PATH="obsidian (2)"
YANDEX_VOICE_RAW="obsidian (2)/Life/voice/raw"
VOICE_WHISPER_MODEL=medium
VOICE_WHISPER_DEVICE=cpu
# int8 on CPU (default). float16 if GPU appears later.
# VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_WHISPER_BEAM_SIZE=5
VOICE_WHISPER_BEST_OF=5
VOICE_AUDIO_PREPROCESS=1
VOICE_ROUTE_CONFIG=/root/projects/empire/data/voice_route_config.json
VAULT_STAGING=/root/projects/empire/data/voice_vault_staging

