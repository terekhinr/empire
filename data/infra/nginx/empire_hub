# =========================================================================
# Конфигурация для всех сайтов медиаимперии.
#   neverretire.ru  → 127.0.0.1:8000 (web_app.py)
#   gdepar.ru       → 127.0.0.1:8001 (gdepar_app.py)
#   /hub/           → 127.0.0.1:8501 (Streamlit dashboard)
#   /tasks/         → 127.0.0.1:8502 (planning PWA)
#
# HTTP→HTTPS только если запрос не через HTTPS-прокси (Cloudflare Flexible).
# =========================================================================

map $http_x_forwarded_proto $is_https_request {
    default 0;
    "https" 1;
}

# -------------------- 1. NEVERRETIRE.RU --------------------
server {
    listen 80;
    listen [::]:80;
    server_name neverretire.ru www.neverretire.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        if ($is_https_request = 0) {
            return 301 https://$host$request_uri;
        }
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_cache_bypass $http_upgrade;
    }

    include /root/projects/empire/deploy/nginx/neverretire_dashboard.inc;
    include /root/projects/empire/deploy/nginx/neverretire_planning.inc;

    location /static/ {
        alias /root/projects/empire/static/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name neverretire.ru www.neverretire.ru;

    ssl_certificate /etc/letsencrypt/live/neverretire.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/neverretire.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    include /root/projects/empire/deploy/nginx/neverretire_dashboard.inc;
    include /root/projects/empire/deploy/nginx/neverretire_planning.inc;

    location /static/ {
        alias /root/projects/empire/static/;
        expires 7d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
}

