[Unit]
Description=Empire diagnostics watchdog (timers, logs, auto-remediation, Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/root/projects/empire/.env
ExecStart=/root/projects/empire/venv/bin/python /root/projects/empire/scripts/empire_diagnostics_watchdog.py
User=root
Nice=5

[Install]
WantedBy=multi-user.target
