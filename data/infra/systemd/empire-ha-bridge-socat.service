[Unit]
Description=TCP proxy HA notify -> VPS empire bridge
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:8766,bind=0.0.0.0,reuseaddr,fork TCP:100.84.19.35:8877
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
