[Unit]
Description=Empire HA API tunnel via Flint reverse SSH (:18123 → 192.168.1.41:8123)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -i /root/.ssh/id_ed25519 -L 127.0.0.1:18123:192.168.1.41:8123 -p 6223 root@127.0.0.1
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
