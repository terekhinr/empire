[Unit]
Description=Garden channel sales bot (infoproduct)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/empire
Environment=PATH=/root/projects/empire/venv/bin
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/root/projects/empire/.env
ExecStart=/root/projects/empire/venv/bin/python empire_garden_bot.py
Restart=always
RestartSec=10
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
