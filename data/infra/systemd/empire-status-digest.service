[Unit]
Description=Empire VPS status digest → Telegram (утро/вечер)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/root/projects/empire/.env
ExecStart=/root/projects/empire/venv/bin/python /root/projects/empire/scripts/empire_status_digest.py
User=root
Nice=10

[Install]
WantedBy=multi-user.target
