[Unit]
Description=Empire Tasks (planning PWA + API)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/empire
Environment=PATH=/root/projects/empire/venv/bin
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/root/projects/empire/.env
ExecStart=/root/projects/empire/venv/bin/uvicorn planning_api:app --host 127.0.0.1 --port 8502 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
MemoryMax=256M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
