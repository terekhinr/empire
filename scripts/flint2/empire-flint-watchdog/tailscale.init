#!/bin/sh /etc/rc.common
# Empire: Tailscale with persistent statedir on overlay (/etc), NOT /var->tmp.
USE_PROCD=1
START=80

start_service() {
  local port std_err std_out fw_mode statedir

  config_load tailscale
  config_get_bool std_out "settings" log_stdout 1
  config_get_bool std_err "settings" log_stderr 1
  config_get port "settings" port 41641
  config_get fw_mode "settings" fw_mode nftables
  config_get statedir "settings" statedir /etc/tailscale/statedir

  mkdir -p "$statedir"
  /usr/sbin/tailscaled --cleanup 2>/dev/null || true

  procd_open_instance
  procd_set_param command /usr/sbin/tailscaled
  procd_set_param env TS_DEBUG_FIREWALL_MODE="$fw_mode"
  procd_append_param command --port "$port"
  procd_append_param command --statedir "$statedir"
  procd_append_param command --state "$statedir/tailscaled.state"
  procd_set_param respawn
  procd_set_param stdout "$std_out"
  procd_set_param stderr "$std_err"
  procd_close_instance
}

stop_service() {
  /usr/sbin/tailscaled --cleanup 2>/dev/null || true
}
