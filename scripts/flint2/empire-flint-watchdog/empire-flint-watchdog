#!/bin/sh
# empire-flint-watchdog — самодиагностика и автопочинка НА роутере Flint (OpenWrt).
# Не нужен VPS, Cursor, ИИ. Только cron/procd на самом роутере.
#
# Режимы: /etc/empire/bypass-mode = vps | novps
#   vps   — YouTube через podkop/VLESS; zapret — страховка и failover
#   novps — YouTube через zapret (DPI), без Empire VPS
# Установка: install.sh (с VPS) или install-local.sh (на Flint / USB)
# Запуск:    empire-flint-watchdog
# Только проверка: empire-flint-watchdog --check
# Принудительно: empire-flint-watchdog --force
#
# Лог:   /tmp/empire-flint-watchdog.log
# State: /tmp/empire-flint-watchdog.state
set -eu
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:/opt/bin:/opt/sbin:$PATH"

# shellcheck disable=SC1091
[ -f /etc/empire/mode-lib.sh ] && . /etc/empire/mode-lib.sh

LOG="${EMPIRE_FLINT_LOG:-/tmp/empire-flint-watchdog.log}"
STATE="${EMPIRE_FLINT_STATE:-/tmp/empire-flint-watchdog.state}"
COOLDOWN_SEC="${EMPIRE_FLINT_COOLDOWN:-900}"  # 15 мин между рестартами одного сервиса
TG_COOLDOWN_SEC="${EMPIRE_FLINT_TG_COOLDOWN:-1800}"  # 30 мин — один и тот же отчёт в TG
MAX_LOG_LINES=400

CHECK_ONLY=0
FORCE=0
for a in "$@"; do
  case "$a" in
    --check|-c) CHECK_ONLY=1 ;;
    --force|-f) FORCE=1 ;;
    --help|-h)
      echo "Usage: empire-flint-watchdog [--check|--force]"
      exit 0
      ;;
  esac
done

log() {
  line="$(date -Is 2>/dev/null || date) $*"
  echo "$line" >>"$LOG"
  if [ -f "$LOG" ]; then
    lines=$(wc -l <"$LOG" 2>/dev/null || echo 0)
    if [ "$lines" -gt "$MAX_LOG_LINES" ]; then
      tail -n 200 "$LOG" >"${LOG}.tmp" && mv "${LOG}.tmp" "$LOG"
    fi
  fi
  # В cron — только файл; в --check или EMPIRE_FLINT_VERBOSE=1 — в stdout.
  # Важно: при set -e нельзя оставлять ложный exit у последнего [ ] — иначе cron умирает после START.
  if [ "${EMPIRE_FLINT_VERBOSE:-0}" = "1" ] || [ "$CHECK_ONLY" = "1" ]; then
    echo "$line"
  fi
}

now_epoch() { date +%s; }

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\n/\\n/g'
}

tg_can_send() {
  key="$1"
  [ "$CHECK_ONLY" = "1" ] && return 1
  last=$(state_get "tg_${key}_ts")
  [ -z "$last" ] && return 0
  now=$(now_epoch)
  [ $((now - last)) -ge "$TG_COOLDOWN_SEC" ] && return 0
  return 1
}

tg_mark_sent() {
  state_set "tg_$1_ts" "$(now_epoch)"
}

tg_notify_repair() {
  # TG отключён: хилер чинит молча. Сводка — утро/вечер status-digest на VPS.
  return 0
}

lan_apply_patch() {
  [ -x /usr/sbin/empire-singbox-mark ] && /usr/sbin/empire-singbox-mark 2>/dev/null || true
  [ -x /usr/sbin/empire-singbox-patch ] && /usr/sbin/empire-singbox-patch 2>/dev/null || true
  [ -x /etc/podkop/empire-lan-fix.sh ] && /etc/podkop/empire-lan-fix.sh >/dev/null 2>&1 || true
}

lan_proxy_synced() {
  CFG=/etc/sing-box/config.json
  [ -f "$CFG" ] || return 1
  mode=$(jq -r '.inbounds[]|select(.tag=="tproxy-in")|.type' "$CFG" 2>/dev/null || echo "")
  case "$mode" in
    tproxy)
      nft list chain inet PodkopTable proxy 2>/dev/null | grep -q 'tproxy ip to 127.0.0.1:1602' || return 1
      ;;
    redirect)
      nft list chain inet PodkopTable proxy 2>/dev/null | grep -qE 'redirect to :1602' || return 1
      ;;
    *) return 1 ;;
  esac
  return 0
}

ha_telegram_send() {
  # Telegram-уведомление через Home Assistant rest_command empire_telegram.
  # HA доставляет в Telegram (в т.ч. через мост на VPS), токены Telegram на роутере не нужны.
  msg="$1"
  ENV_FILE="/etc/empire-flint-ui.env"
  HA_URL="http://192.168.1.41:8123"
  HA_TOKEN=""

  if [ -f "$ENV_FILE" ]; then
    # shellcheck disable=SC1090
    . "$ENV_FILE" 2>/dev/null || true
  fi

  HA_URL="${HA_URL:-http://192.168.1.41:8123}"
  HA_TOKEN="${HA_TOKEN:-}"
  [ -n "$HA_TOKEN" ] || return 1

  payload="{\"message\":\"$(json_escape "$msg")\"}"
  curl -s -m 12 -X POST \
    -H "Authorization: Bearer $HA_TOKEN" \
    -H "Content-Type: application/json" \
    -d "$payload" \
    "$HA_URL/api/services/rest_command/empire_telegram" >/dev/null 2>&1 || return 1
  return 0
}

state_get() {
  # state_get KEY → value
  [ -f "$STATE" ] || { echo ""; return 0; }
  sed -n "s/^$1=//p" "$STATE" | tail -1
}

state_set() {
  key="$1"
  val="$2"
  tmp="${STATE}.new"
  if [ -f "$STATE" ]; then
    grep -v "^${key}=" "$STATE" >"$tmp" || true
  else
    : >"$tmp"
  fi
  echo "${key}=${val}" >>"$tmp"
  mv "$tmp" "$STATE"
}

can_fix() {
  # can_fix name → 0 если можно чинить
  name="$1"
  [ "$FORCE" = "1" ] && return 0
  cool="$COOLDOWN_SEC"
  # USB/Samba отваливаются часто (sda→sdb) — короткий cooldown
  case "$name" in
    usb|samba|wsdd|download_share|ai_awg|doh_block) cool=120 ;;
  esac
  last=$(state_get "fix_${name}_ts")
  [ -z "$last" ] && return 0
  now=$(now_epoch)
  ago=$((now - last))
  [ "$ago" -ge "$cool" ] && return 0
  log "SKIP fix $name (cooldown ${ago}s < ${cool}s)"
  return 1
}

mark_fix() {
  state_set "fix_$1_ts" "$(now_epoch)"
}

# --- checks ---

ok_singbox() {
  pgrep -f 'sing-box|singbox' >/dev/null 2>&1
}

ok_podkop_svc() {
  # в режиме без VPS podkop не обязателен
  if type empire_is_novps >/dev/null 2>&1 && empire_is_novps; then
    return 0
  fi
  ok_singbox && return 0
  /etc/init.d/podkop status 2>/dev/null | grep -qi running && return 0
  return 1
}

ok_offload() {
  if type empire_ok_offload_off >/dev/null 2>&1; then
    empire_ok_offload_off
    return $?
  fi
  return 0
}

ok_zapret() {
  pgrep -f 'nfqws2|nfqws' >/dev/null 2>&1 && return 0
  if [ -x /etc/init.d/zapret2 ]; then
    /etc/init.d/zapret2 status 2>/dev/null | grep -qi running && return 0
  fi
  if [ -x /etc/init.d/zapret ]; then
    /etc/init.d/zapret status 2>/dev/null | grep -qi running && return 0
  fi
  return 1
}

ok_gemini() {
  # Gemini в списке ai_awg → Amnezia. Отдельный curl часто даёт 403/000 при живом туннеле.
  if ok_ai_awg 2>/dev/null; then
    return 0
  fi
  if ip link show awg0 >/dev/null 2>&1; then
    code=$(curl --interface awg0 -4 -s -o /dev/null -w '%{http_code}' --connect-timeout 8 --max-time 15 \
      https://gemini.google.com/ 2>/dev/null || echo 000)
  else
    code=$(curl -4 -s -o /dev/null -w '%{http_code}' --connect-timeout 8 --max-time 15 \
      https://gemini.google.com/ 2>/dev/null || echo 000)
  fi
  case "$code" in
    200|301|302|403|421) return 0 ;;
    *) return 1 ;;
  esac
}

# podkop секция ai_awg → awg0 + FakeIP для Cursor/OpenAI (иначе уходят на ISP)
ok_ai_awg() {
  if type empire_is_novps >/dev/null 2>&1 && empire_is_novps; then
    return 0
  fi
  iface=$(uci -q get podkop.ai_awg.interface 2>/dev/null || true)
  ctype=$(uci -q get podkop.ai_awg.connection_type 2>/dev/null || true)
  [ "$iface" = "awg0" ] || return 1
  [ "$ctype" = "vpn" ] || return 1
  domains=$(uci -q get podkop.ai_awg.user_domains_text 2>/dev/null || true)
  echo " $domains " | grep -q ' cursor.com ' || echo " $domains " | grep -q ' api2.cursor.sh ' || return 1
  CFG=/etc/sing-box/config.json
  [ -f "$CFG" ] || return 1
  # критично: bind на awg0
  grep -q '"bind_interface": "awg0"' "$CFG" 2>/dev/null || return 1
  # критично: user-domains должны быть в маршруте И в FakeIP DNS
  # иначе nslookup даёт 104.18.x → Cursor идёт мимо Amnezia
  grep -q 'ai_awg-user-domains-ruleset' "$CFG" 2>/dev/null || return 1
  # FakeIP для cursor (198.18.x) — главный сигнал «трафик пойдёт в tproxy→awg»
  cip=$(nslookup api2.cursor.sh 127.0.0.1 2>/dev/null | awk '/^Address:/{print $2}' | grep -v ':' | tail -1)
  case "$cip" in
    198.18.*) ;;
    *) return 1 ;;
  esac
  ok_awg || return 1
  return 0
}

ok_awg() {
  if type empire_is_novps >/dev/null 2>&1 && empire_is_novps; then
    awg show awg0 >/dev/null 2>&1 || return 0
  fi
  # Раньше: только «интерфейс есть» → пропускали мёртвый handshake.
  # Теперь: свежий handshake (<=180s при keepalive 25) + probe через awg0.
  out=$(awg show awg0 2>/dev/null || wg show awg0 2>/dev/null) || return 1
  echo "$out" | grep -qi 'latest handshake' || return 1
  echo "$out" | grep -qi 'latest handshake: never' && return 1
  line=$(echo "$out" | grep -i 'latest handshake' | head -1)
  age=0
  d=$(echo "$line" | sed -n 's/.*[^0-9]\([0-9][0-9]*\) day.*/\1/p')
  [ -z "$d" ] && d=$(echo "$line" | sed -n 's/^\([0-9][0-9]*\) day.*/\1/p')
  h=$(echo "$line" | sed -n 's/.*[^0-9]\([0-9][0-9]*\) hour.*/\1/p')
  [ -z "$h" ] && h=$(echo "$line" | sed -n 's/^\([0-9][0-9]*\) hour.*/\1/p')
  m=$(echo "$line" | sed -n 's/.*[^0-9]\([0-9][0-9]*\) minute.*/\1/p')
  [ -z "$m" ] && m=$(echo "$line" | sed -n 's/^\([0-9][0-9]*\) minute.*/\1/p')
  s=$(echo "$line" | sed -n 's/.*[^0-9]\([0-9][0-9]*\) second.*/\1/p')
  [ -z "$s" ] && s=$(echo "$line" | sed -n 's/^\([0-9][0-9]*\) second.*/\1/p')
  [ -n "$d" ] && age=$((age + d * 86400))
  [ -n "$h" ] && age=$((age + h * 3600))
  [ -n "$m" ] && age=$((age + m * 60))
  [ -n "$s" ] && age=$((age + s))
  # если единицы не распарсились, но строка есть — считаем мёртвым
  if [ "$age" -eq 0 ] && ! echo "$line" | grep -Eq '[0-9]+[[:space:]]+second'; then
    return 1
  fi
  max_age="${EMPIRE_AWG_MAX_AGE:-180}"
  [ "$age" -le "$max_age" ] || return 1
  code=$(curl --interface awg0 -4 -s -o /dev/null -w '%{http_code}' \
    --connect-timeout 8 --max-time 12 https://1.1.1.1/ 2>/dev/null || echo 000)
  case "$code" in
    200|301|302) return 0 ;;
    *) return 1 ;;
  esac
}

ok_dns() {
  nslookup youtube.com 127.0.0.1 >/dev/null 2>&1 || nslookup youtube.com >/dev/null 2>&1
}

# DoH с LAN ломает «один IP» для Cursor веб/Windows
ok_doh_block() {
  nft list table inet empire_doh >/dev/null 2>&1 || return 1
  nft list chain inet empire_doh forward_doh 2>/dev/null | grep -q 'dport' || return 1
  return 0
}

ok_youtube() {
  # generate_204 + главная — ловим и «сайт мёртв», и DPI
  code=$(curl -4 -s -o /dev/null -w '%{http_code}' --connect-timeout 8 --max-time 12 \
    https://www.youtube.com/generate_204 2>/dev/null || echo 000)
  case "$code" in
    204|200) ;;
    *)
      code2=$(curl -4 -s -o /dev/null -w '%{http_code}' --connect-timeout 8 --max-time 12 \
        https://www.youtube.com/ 2>/dev/null || echo 000)
      case "$code2" in
        200|301|302) code="$code2" ;;
        *) return 1 ;;
      esac
      ;;
  esac
  # картинка CDN — ближе к реальному видео, чем одна 204
  img=$(curl -4 -s -o /dev/null -w '%{http_code}' --connect-timeout 8 --max-time 12 \
    https://i.ytimg.com/generate_204 2>/dev/null || echo 000)
  case "$img" in
    204|200|404) return 0 ;;  # 404 на generate_204 у ytimg бывает, но TCP/TLS жив
    *)
      # если сайт YT ок, а ytimg упал — всё равно чиним
      return 1
      ;;
  esac
}

ok_routes() {
  if type empire_is_novps >/dev/null 2>&1 && empire_is_novps; then
    return 0
  fi
  if type empire_in_failover >/dev/null 2>&1 && empire_in_failover; then
    return 0
  fi
  CFG=/etc/sing-box/config.json
  [ -f "$CFG" ] || return 1
  ip rule list 2>/dev/null | grep -q 'fwmark 0x100000.*lookup podkop' || return 1
  ip route list table podkop 2>/dev/null | grep -q 'local default dev lo' || return 1
  lan_proxy_synced || return 1
  command -v jq >/dev/null 2>&1 || return 0
  jq -e '
    [.route.rules[]? | select(.outbound=="main-out") | (.rule_set // [])[]?]
    | index("main-telegram-community-ruleset")
  ' "$CFG" >/dev/null 2>&1 || return 1
  jq -e '.route.default_mark == 2097152' "$CFG" >/dev/null 2>&1 || return 1
  nft list chain inet PodkopTable proxy 2>/dev/null | grep -qE '1602' || return 1
  return 0
}

ok_vless_tunnel() {
  if type empire_is_novps >/dev/null 2>&1 && empire_is_novps; then
    return 0
  fi
  netstat -lnt 2>/dev/null | grep -q '127.0.0.1:18443' || return 1
  pgrep -f 'ssh.*18443' >/dev/null 2>&1 || return 1
  return 0
}

ok_telegram() {
  # Desktop бьёт в DC IP; web/API — дополнительный сигнал
  code=$(curl -4 -s -o /dev/null -w '%{http_code}' --connect-timeout 8 --max-time 12 \
    https://telegram.org/ 2>/dev/null || echo 000)
  case "$code" in
    200|301|302) ;;
    *) return 1 ;;
  esac
  code2=$(curl -4 -s -o /dev/null -w '%{http_code}' --connect-timeout 8 --max-time 12 \
    https://api.telegram.org/ 2>/dev/null || echo 000)
  case "$code2" in
    200|301|302|401|404) return 0 ;;
    *) return 1 ;;
  esac
}

save_golden() {
  CFG=/etc/sing-box/config.json
  GOLD=/etc/podkop/sing-box.golden.json
  [ -f "$CFG" ] || return 0
  # только если маршруты целы
  ok_routes || return 0
  cp -a "$CFG" "$GOLD" 2>/dev/null || true
  chmod 600 "$GOLD" 2>/dev/null || true
}

restore_golden() {
  CFG=/etc/sing-box/config.json
  GOLD=/etc/podkop/sing-box.golden.json
  [ -f "$GOLD" ] || return 1
  cp -a "$GOLD" "$CFG"
  jq '.route.default_mark = 2097152' "$CFG" > /tmp/sb-golden-mark.json 2>/dev/null \
    && mv /tmp/sb-golden-mark.json "$CFG"
  /etc/init.d/sing-box restart 2>/dev/null || true
  sleep 3
  [ -x /etc/podkop/empire-lan-fix.sh ] && /etc/podkop/empire-lan-fix.sh >/dev/null 2>&1 || true
  return 0
}

USB_UUID="01D63D133C7B6100"

ok_usb() {
  # NTFS по UUID (после реконекта бывает sdb6, не sda6). ext3-оверлей = пустой download.
  line=$(grep ' /mnt/usb ' /proc/mounts 2>/dev/null | tail -1 || true)
  [ -n "$line" ] || return 1
  echo "$line" | grep -qE 'fuseblk|ntfs' || return 1
  echo "$line" | grep -q ' ext3 ' && return 1
  dev=$(echo "$line" | awk '{print $1}')
  uuid=$(blkid -s UUID -o value "$dev" 2>/dev/null || true)
  [ "$uuid" = "$USB_UUID" ] || return 1
  [ -d /mnt/usb/download ] || return 1
  # I/O живой (иначе Windows «диск отвалился»)
  touch /mnt/usb/download/.empire_usb_ok 2>/dev/null || return 1
  return 0
}

ok_download_share() {
  ok_usb || return 1
  share_path=$(uci -q get samba4.download.path 2>/dev/null || true)
  [ "$share_path" = "/mnt/usb/download" ] || return 1
  share_name=$(uci -q get samba4.download.name 2>/dev/null || true)
  [ "$share_name" = "download" ] || return 1
  share_wg=$(uci -q get samba4.@samba[0].workgroup 2>/dev/null || true)
  [ "$share_wg" = "HOME" ] || return 1
  return 0
}

ok_transmission() {
  pgrep -f transmission-daemon >/dev/null 2>&1
}

# Трекеры должны быть FakeIP 198.18.x (VLESS). Реальный IP / NXDOMAIN = снова «не открываются».
ok_torrents() {
  if type empire_is_novps >/dev/null 2>&1 && empire_is_novps; then
    nslookup rutracker.org 127.0.0.1 >/dev/null 2>&1 && return 0
    return 0
  fi
  if type empire_in_failover >/dev/null 2>&1 && empire_in_failover; then
    return 0
  fi
  ip=$(nslookup rutracker.org 127.0.0.1 2>/dev/null | awk '/^Address:/{print $2}' | grep -v ':' | tail -1)
  case "$ip" in
    198.18.*) return 0 ;;
  esac
  return 1
}

ok_samba() {
  pgrep -f 'smbd|samba' >/dev/null 2>&1 || return 1
  ok_download_share || return 1
  # порт 445 слушает
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | grep -qE ':445\s' || return 1
  elif command -v netstat >/dev/null 2>&1; then
    netstat -ltn 2>/dev/null | grep -qE ':445\s' || return 1
  fi
  return 0
}

ok_wsdd() {
  # без wsdd2 Windows не видит FLINT в «Сеть»; шара по IP всё равно должна работать
  [ -x /etc/init.d/wsdd2 ] || return 0
  pgrep -f 'wsdd' >/dev/null 2>&1
}

ok_reverse_tunnel() {
  if type empire_is_novps >/dev/null 2>&1 && empire_is_novps; then
    return 0
  fi
  pgrep -f "ssh.*-R 127.0.0.1:6223" >/dev/null 2>&1
}

# --- fixes ---

fix_podkop() {
  can_fix podkop || return 1
  log "FIX podkop"
  /etc/init.d/podkop enable 2>/dev/null || true
  lan_apply_patch
  if ! pgrep -f '/usr/bin/sing-box run' >/dev/null 2>&1; then
    /etc/init.d/podkop start 2>/dev/null || true
    sleep 8
    lan_apply_patch
  fi
  if ! ok_podkop_svc || ! lan_proxy_synced; then
    if can_fix podkop_restart; then
      log "FIX podkop restart (sync proxy)"
      /etc/init.d/podkop restart 2>/dev/null || true
      sleep 20
      lan_apply_patch
      mark_fix podkop_restart
    fi
  fi
  mark_fix podkop
  ok_podkop_svc && lan_proxy_synced && log "FIX podkop OK" && return 0
  log "FIX podkop STILL BAD"
  return 1
}

fix_vless_tunnel() {
  can_fix vless_tunnel || return 1
  log "FIX vless SSH tunnel"
  [ -x /etc/empire/enforce-vless-ssh.sh ] && /etc/empire/enforce-vless-ssh.sh >/dev/null 2>&1 || true
  sleep 2
  mark_fix vless_tunnel
  ok_vless_tunnel && log "FIX vless tunnel OK" && return 0
  log "FIX vless tunnel STILL BAD"
  return 1
}

fix_offload() {
  can_fix offload || return 1
  log "FIX flow offloading OFF (nfqws иначе не видит пакеты)"
  if type empire_fix_offload >/dev/null 2>&1; then
    empire_fix_offload
  fi
  mark_fix offload
  ok_offload && log "FIX offload OK" && return 0
  return 1
}

fix_zapret() {
  can_fix zapret || return 1
  log "FIX zapret restart"
  if [ -x /etc/init.d/zapret2 ]; then
    /etc/init.d/zapret2 enable 2>/dev/null || true
    /etc/init.d/zapret2 restart 2>/dev/null || /etc/init.d/zapret2 start 2>/dev/null || true
  elif [ -x /etc/init.d/zapret ]; then
    /etc/init.d/zapret enable 2>/dev/null || true
    /etc/init.d/zapret restart 2>/dev/null || true
  fi
  sleep 2
  mark_fix zapret
  ok_zapret && log "FIX zapret OK" && return 0
  log "FIX zapret STILL BAD"
  return 1
}

fix_youtube() {
  # YouTube: без VPS — zapret; с VPS — podkop + zapret
  if type empire_is_novps >/dev/null 2>&1 && empire_is_novps; then
    fix_zapret || true
    if type empire_fix_offload >/dev/null 2>&1; then
      empire_fix_offload
    fi
  else
    fix_podkop || true
    fix_zapret || true
  fi
  sleep 3
  if ok_youtube; then
    log "FIX youtube OK"
    return 0
  fi
  [ -x /etc/podkop/empire-lan-fix.sh ] && /etc/podkop/empire-lan-fix.sh >/dev/null 2>&1 || true
  sleep 2
  if ok_youtube; then log "FIX youtube OK after lan-fix"; return 0; fi
  log "FIX youtube STILL BAD after podkop+zapret"
  return 1
}

fix_routes() {
  can_fix routes || return 1
  log "FIX routes"
  lan_apply_patch
  sleep 2
  if ok_routes; then
    mark_fix routes
    log "FIX routes OK"
    return 0
  fi
  fix_podkop || true
  sleep 3
  lan_apply_patch
  if ok_routes; then
    mark_fix routes
    log "FIX routes OK after podkop"
    return 0
  fi
  log "FIX routes: restore golden"
  restore_golden || true
  lan_apply_patch
  sleep 2
  mark_fix routes
  ok_routes && log "FIX routes OK after golden" && return 0
  log "FIX routes STILL BAD"
  return 1
}

fix_telegram() {
  can_fix telegram || return 1
  log "FIX telegram (routes + podkop)"
  fix_routes || true
  fix_podkop || true
  sleep 3
  mark_fix telegram
  if ok_telegram; then
    log "FIX telegram OK"
    return 0
  fi
  log "FIX telegram STILL BAD"
  return 1
}

fix_awg() {
  can_fix awg || return 1
  log "FIX amnezia awg0 (ifup + split + awg-quick)"
  # UCI/netifd путь надёжнее голого awg-quick на OpenWrt
  ifdown awg0 2>/dev/null || true
  sleep 1
  ifup awg0 2>/dev/null || true
  /etc/init.d/amnezia-split restart 2>/dev/null || true
  sh /etc/amnezia/start-split.sh 2>/dev/null || true
  # fallback
  if ! awg show awg0 >/dev/null 2>&1; then
    awg-quick down awg0 2>/dev/null || true
    awg-quick up awg0 2>/dev/null || true
  fi
  sleep 5
  mark_fix awg
  if ok_awg; then
    log "FIX awg OK"
    return 0
  fi
  log "FIX awg STILL BAD"
  return 1
}

fix_ai_awg() {
  can_fix ai_awg || return 1
  log "FIX ai_awg: Cursor/OpenAI FakeIP + bind awg0"
  ok_awg || fix_awg || true
  # stale Amnezia → Vienna backup (если есть conf)
  if [ -x /usr/sbin/empire-awg-failover ]; then
    /usr/sbin/empire-awg-failover ensure >/dev/null 2>&1 || true
  fi
  # 1) LKG/golden — без podkop regenerate (race → duplicate rule-set tags)
  if [ -x /usr/sbin/empire-singbox-lkg ]; then
    /usr/sbin/empire-singbox-lkg restore >/tmp/empire-ai-fix.out 2>&1 || true
    sleep 3
    if ok_ai_awg; then
      mark_fix ai_awg
      log "FIX ai_awg OK (lkg)"
      return 0
    fi
  fi
  restore_golden || true
  sleep 3
  if ok_ai_awg; then
    mark_fix ai_awg
    log "FIX ai_awg OK (golden)"
    return 0
  fi
  # 2) локальная 36 — только если LKG не помог (может дернуть podkop)
  if [ -x /etc/amnezia/36-ai-via-amnezia.sh ]; then
    sh /etc/amnezia/36-ai-via-amnezia.sh >/tmp/empire-ai-fix.out 2>&1 || true
    sleep 4
    if ok_ai_awg; then
      mark_fix ai_awg
      log "FIX ai_awg OK (local 36)"
      return 0
    fi
  fi
  mark_fix ai_awg
  ok_ai_awg && log "FIX ai_awg OK" && return 0
  log "FIX ai_awg STILL BAD"
  return 1
}

fix_usb() {
  can_fix usb || return 1
  log "FIX usb: NTFS by UUID (not hardcoded sda6)"
  if [ -x /etc/init.d/empire-usb-mount ]; then
    /etc/init.d/empire-usb-mount start 2>/dev/null || true
  else
    # fallback без init: прямой mount
    mkdir -p /mnt/usb
    DEV=$(blkid -U "$USB_UUID" 2>/dev/null || true)
    if [ -n "$DEV" ] && [ -b "$DEV" ]; then
      umount /mnt/usb 2>/dev/null || umount -l /mnt/usb 2>/dev/null || true
      mount -t ntfs-3g -o rw,allow_other "$DEV" /mnt/usb 2>/dev/null || \
        mount -t ntfs3 -o rw "$DEV" /mnt/usb 2>/dev/null || true
      mkdir -p /mnt/usb/download 2>/dev/null || true
    fi
  fi
  sleep 2
  mark_fix usb
  if ok_usb; then
    log "FIX usb OK (NTFS download)"
    /etc/init.d/samba4 restart 2>/dev/null || /etc/init.d/samba restart 2>/dev/null || true
    return 0
  fi
  log "FIX usb STILL BAD"
  return 1
}

fix_transmission() {
  can_fix transmission || return 1
  log "FIX transmission"
  uci -q delete transmission.transmission 2>/dev/null || true
  uci set transmission.@transmission[0].enabled=1 2>/dev/null || true
  uci set transmission.@transmission[0].config_dir=/etc/transmission/config 2>/dev/null || true
  uci set transmission.@transmission[0].config_overwrite=0 2>/dev/null || true
  uci commit transmission 2>/dev/null || true
  /etc/init.d/transmission enable 2>/dev/null || true
  /etc/init.d/transmission restart 2>/dev/null || true
  mark_fix transmission
  sleep 2
  ok_transmission && log "FIX transmission OK" && return 0
  return 1
}

fix_torrents() {
  can_fix torrents || return 1
  log "FIX torrents: user_domains FakeIP + VLESS"
  DOMAINS="rutracker.org www.rutracker.org rutracker.net rutracker.cc static.rutracker.cc feed.rutracker.cc rutracker.wiki bt.t-ru.org bt2.t-ru.org bt3.t-ru.org bt4.t-ru.org tr.t-ru.org rutor.info www.rutor.info nnmclub.to nnm-club.me nnmstatic.win kinozal.tv 1337x.to flibusta.is www.flibusta.is http.flibusta.is mobile.flibusta.is proxy.flibusta.is"
  if [ -f /etc/podkop/torrent-domains.txt ]; then
    DOMAINS="$(grep -v '^#' /etc/podkop/torrent-domains.txt | grep -v '^[[:space:]]*$' | tr '\n' ' ')"
  fi
  uci set podkop.main.user_domain_list_type='text'
  CUR="$(uci -q get podkop.main.user_domains_text || true)"
  PAD=" $CUR "
  for d in $DOMAINS; do
    echo "$PAD" | grep -q " $d " && continue
    CUR="${CUR:+$CUR }$d"
    PAD=" $CUR "
  done
  uci set podkop.main.user_domains_text="$CUR"
  uci commit podkop
  /etc/init.d/podkop reload 2>/dev/null || true
  sleep 4
  [ -x /etc/podkop/empire-lan-fix.sh ] && /etc/podkop/empire-lan-fix.sh >/dev/null 2>&1 || true
  mark_fix torrents
  sleep 2
  ok_torrents && log "FIX torrents OK" && return 0
  log "FIX torrents STILL BAD"
  return 1
}

fix_samba() {
  can_fix samba || return 1
  log "FIX samba: UCI share download + HOME + user home"
  # сначала диск — иначе шара на пустом /mnt/usb
  ok_usb || fix_usb || true

  DL="/mnt/usb/download"
  mkdir -p "$DL" 2>/dev/null || true

  uci -q set samba4=samba 2>/dev/null || true
  if ! uci -q get samba4.@samba[0] >/dev/null 2>&1; then
    uci add samba4 samba >/dev/null 2>&1 || true
  fi
  uci set samba4.@samba[0].name='FLINT' 2>/dev/null || true
  uci set samba4.@samba[0].workgroup='HOME' 2>/dev/null || true
  uci set samba4.@samba[0].charset='UTF-8' 2>/dev/null || true
  uci set samba4.@samba[0].description='Flint download' 2>/dev/null || true
  uci set samba4.@samba[0].disable_async_io='1' 2>/dev/null || true

  uci -q delete samba4.download 2>/dev/null || true
  uci set samba4.download=sambashare
  uci set samba4.download.name='download'
  uci set samba4.download.path="$DL"
  uci set samba4.download.read_only='no'
  uci set samba4.download.guest_ok='yes'
  uci set samba4.download.create_mask='0664'
  uci set samba4.download.dir_mask='0775'
  uci commit samba4 2>/dev/null || true

  # Never: Windows шлёт имя локального юзера → Bad User→guest → SMB отваливается.
  # Доступ только home/home; на ПК — usb-disk.bat один раз (cmdkey + schtasks).
  if [ -f /etc/samba/smb.conf.template ]; then
    sed -i 's/map to guest = Bad User/map to guest = Never/' /etc/samba/smb.conf.template 2>/dev/null || true
  fi
  if ! grep -q '^home:' /etc/passwd 2>/dev/null; then
    echo 'home:x:1000:65534:samba:/var:/bin/false' >> /etc/passwd
  fi
  if command -v smbpasswd >/dev/null 2>&1; then
    printf '%s\n%s\n' home home | smbpasswd -L -s -a home >/dev/null 2>&1 || \
      printf '%s\n%s\n' home home | smbpasswd -s -a home >/dev/null 2>&1 || true
  fi
  # Windows часто держит битый кэш пароля → «устройство не работает».
  # На роутере мы только гарантируем home/home; клиент чистит Credential Manager.

  /etc/init.d/samba4 enable 2>/dev/null || true
  /etc/init.d/samba4 restart 2>/dev/null || /etc/init.d/samba restart 2>/dev/null || true
  # wsdd — обнаружение в Windows «Сеть»
  /etc/init.d/wsdd2 enable 2>/dev/null || true
  /etc/init.d/wsdd2 restart 2>/dev/null || true

  mark_fix samba
  sleep 2
  if ok_samba; then
    log "FIX samba OK (\\\\192.168.1.1\\download)"
    return 0
  fi
  log "FIX samba STILL BAD"
  return 1
}

fix_wsdd() {
  can_fix wsdd || return 1
  log "FIX wsdd2"
  /etc/init.d/wsdd2 enable 2>/dev/null || true
  /etc/init.d/wsdd2 restart 2>/dev/null || true
  mark_fix wsdd
  sleep 1
  ok_wsdd && return 0
  return 1
}

fix_download_share() {
  # алиас: полная починка USB+Samba
  can_fix download_share || return 1
  fix_usb || true
  fix_samba || true
  mark_fix download_share
  ok_download_share && ok_samba && return 0
