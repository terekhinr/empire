}

fix_dns() {
  can_fix dns || return 1
  log "FIX dnsmasq restart"
  /etc/init.d/dnsmasq restart 2>/dev/null || true
  mark_fix dns
  sleep 2
  ok_dns && return 0
  return 1
}

fix_doh_block() {
  can_fix doh_block || return 1
  log "FIX DoH block (Windows Secure DNS иначе ломает Cursor→Amnezia)"
  if [ -f /etc/podkop/block-doh.nft ]; then
    nft delete table inet empire_doh 2>/dev/null || true
    nft -f /etc/podkop/block-doh.nft 2>/dev/null || true
  fi
  if [ -f /etc/dnsmasq.d/99-block-doh.conf ] || [ -f /tmp/dnsmasq.d/99-block-doh.conf ]; then
    /etc/init.d/dnsmasq restart 2>/dev/null || true
  fi
  # firewall.user должен подгружать nft при рестарте fw
  if [ -f /etc/firewall.user ] && ! grep -q 'block-doh.nft' /etc/firewall.user 2>/dev/null; then
    echo 'nft -f /etc/podkop/block-doh.nft' >> /etc/firewall.user
  fi
  mark_fix doh_block
  sleep 1
  ok_doh_block && log "FIX doh_block OK" && return 0
  log "FIX doh_block STILL BAD"
  return 1
}

# --- main ---

main() {
  log "=== START check_only=$CHECK_ONLY force=$FORCE ==="
  problems=""
  fixed=""
  report=""

  check_one() {
    name="$1"
    if "ok_$name"; then
      report="${report}OK $name; "
      log "OK $name"
      return 0
    fi
    report="${report}FAIL $name; "
    log "FAIL $name"
    problems="${problems}${name} "
    if [ "$CHECK_ONLY" = "1" ]; then
      return 1
    fi
    case "$name" in
      singbox|podkop_svc)
        fix_podkop && fixed="${fixed}podkop " || true
        ;;
      zapret) fix_zapret && fixed="${fixed}zapret " || true ;;
      offload) fix_offload && fixed="${fixed}offload " || true ;;
      routes) fix_routes && fixed="${fixed}routes " || true ;;
      vless_tunnel) fix_vless_tunnel && fixed="${fixed}vless_tunnel " || true ;;
      telegram) fix_telegram && fixed="${fixed}telegram " || true ;;
      youtube) fix_youtube && fixed="${fixed}youtube " || true ;;
      gemini) fix_ai_awg && fixed="${fixed}gemini " || true ;;
      awg) fix_awg && fixed="${fixed}awg " || true ;;
      ai_awg) fix_ai_awg && fixed="${fixed}ai_awg " || true ;;
      dns) fix_dns && fixed="${fixed}dns " || true ;;
      doh_block) fix_doh_block && fixed="${fixed}doh_block " || true ;;
      usb) fix_usb && fixed="${fixed}usb " || true ;;
      transmission) fix_transmission && fixed="${fixed}transmission " || true ;;
      torrents) fix_torrents && fixed="${fixed}torrents " || true ;;
      samba) fix_samba && fixed="${fixed}samba " || true ;;
      wsdd) fix_wsdd && fixed="${fixed}wsdd " || true ;;
      download_share) fix_download_share && fixed="${fixed}download_share " || true ;;
      reverse_tunnel) fix_reverse && fixed="${fixed}reverse " || true ;;
    esac
    return 1
  }

  # порядок: база → маршруты → сервисы
  check_one offload || true
  if type empire_is_novps >/dev/null 2>&1 && empire_is_novps; then
    check_one zapret || true
    check_one dns || true
    check_one youtube || true
    check_one telegram || true
  else
    check_one vless_tunnel || true
    check_one podkop_svc || true
    check_one routes || true
    check_one zapret || true
    check_one dns || true
    check_one doh_block || true
    check_one youtube || true
    check_one gemini || true
    check_one telegram || true
    check_one torrents || true
    check_one awg || true
    check_one ai_awg || true
    check_one reverse_tunnel || true
  fi
  check_one usb || true
  check_one download_share || true
  check_one transmission || true
  check_one samba || true
  check_one wsdd || true

  # VLESS мёртв → YouTube через zapret (только режим vps)
  if [ "$CHECK_ONLY" = "0" ] && [ -x /usr/sbin/empire-vless-failover ]; then
    /usr/sbin/empire-vless-failover >/dev/null 2>&1 || true
  fi

  # итоговая перепроверка если чинили
  if [ -n "$fixed" ] && [ "$CHECK_ONLY" = "0" ]; then
    sleep 2
    if ok_youtube; then
      log "RECHECK youtube OK"
    else
      log "RECHECK youtube STILL FAIL"
      problems="${problems}youtube_recheck "
    fi
    if ok_telegram; then
      log "RECHECK telegram OK"
    else
      log "RECHECK telegram STILL FAIL"
      problems="${problems}telegram_recheck "
    fi
    if ok_routes; then
      log "RECHECK routes OK"
    else
      log "RECHECK routes STILL FAIL"
      problems="${problems}routes_recheck "
    fi
    if ok_gemini; then
      log "RECHECK gemini OK"
    else
      log "RECHECK gemini STILL FAIL"
      problems="${problems}gemini_recheck "
    fi
    if ok_awg; then
      log "RECHECK awg OK"
    else
      log "RECHECK awg STILL FAIL"
      problems="${problems}awg_recheck "
    fi
    if ok_usb; then
      log "RECHECK usb OK"
    else
      log "RECHECK usb STILL FAIL"
      problems="${problems}usb_recheck "
    fi
    if ok_samba; then
      log "RECHECK samba OK"
    else
      log "RECHECK samba STILL FAIL"
      problems="${problems}samba_recheck "
    fi
  fi

  # снимок рабочего конфига — чтобы было из чего восстановить
  skip_golden=0
  type empire_is_novps >/dev/null 2>&1 && empire_is_novps && skip_golden=1
  type empire_in_failover >/dev/null 2>&1 && empire_in_failover && skip_golden=1
  if [ "$skip_golden" = "0" ]; then
    if [ -z "$problems" ] || { ok_routes && ok_youtube && ok_telegram; }; then
      save_golden
    fi
  fi

  state_set last_run "$(date -Is 2>/dev/null || date)"
  state_set last_report "$report"
  state_set last_problems "$problems"
  state_set last_fixed "$fixed"

  still=""
  ok_offload || still="${still}offload "
  if type empire_is_novps >/dev/null 2>&1 && empire_is_novps; then
    ok_zapret || still="${still}zapret "
    ok_youtube || still="${still}youtube "
    ok_dns || still="${still}dns "
  else
    ok_vless_tunnel || still="${still}vless_tunnel "
    ok_podkop_svc || still="${still}podkop "
    ok_routes || still="${still}routes "
    ok_zapret || still="${still}zapret "
    ok_youtube || still="${still}youtube "
    ok_gemini || still="${still}gemini "
    ok_telegram || still="${still}telegram "
    ok_torrents || still="${still}torrents "
    ok_awg || still="${still}awg "
    ok_ai_awg || still="${still}ai_awg "
    ok_dns || still="${still}dns "
    ok_doh_block || still="${still}doh_block "
    ok_reverse_tunnel || still="${still}reverse "
  fi
  # диск и шара — всегда в итоговой оценке (раньше USB FAIL давал exit 0)
  ok_usb || still="${still}usb "
  ok_samba || still="${still}samba "

  if [ -n "$fixed" ] && [ "$CHECK_ONLY" = "0" ]; then
    tg_notify_repair "$problems" "$fixed" "$still"
  fi

  if [ -z "$problems" ]; then
    log "=== DONE all OK ==="
    exit 0
  fi
  log "=== DONE problems=[$problems] fixed=[$fixed] still=[$still] ==="
  [ -z "$still" ] && exit 0
  exit 1
}

main
