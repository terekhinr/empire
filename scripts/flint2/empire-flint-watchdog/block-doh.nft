table inet empire_doh {
  set doh_dns {
    type ipv4_addr
    elements = {
      1.1.1.1, 1.0.0.1, 1.1.1.2, 1.0.0.2, 1.1.1.3, 1.0.0.3,
      8.8.8.8, 8.8.4.4,
      9.9.9.9, 9.9.9.10, 9.9.9.11, 149.112.112.112, 149.112.112.10,
      94.140.14.14, 94.140.15.15, 94.140.14.15, 94.140.15.16,
      185.228.168.9, 185.228.169.9, 185.228.168.10, 185.228.169.11,
      45.90.28.167, 45.90.30.67,
      208.67.222.222, 208.67.220.220,
      76.76.2.22, 76.76.10.22
    }
  }
  chain forward_doh {
    type filter hook forward priority filter - 5; policy accept;
    # DoH/DoT с LAN — иначе Windows Cursor обходит FakeIP → другой IP, чем веб
    iifname "br-lan" ip daddr @doh_dns tcp dport { 443, 853 } drop
    iifname "br-lan" ip daddr @doh_dns udp dport { 443, 853 } drop
    iifname "br-lan" tcp dport 853 drop
    iifname "br-lan" udp dport 853 drop
  }
}
