{
  "route": {
    "final": "direct",
    "auto_detect_interface": true,
    "rules": [
      { "action": "sniff", "timeout": "300ms" },
      { "protocol": "dns", "action": "hijack-dns" },
      { "ip_is_private": true, "outbound": "direct" },
      { "protocol": "bittorrent", "outbound": "direct" },
      {
        "network": "tcp",
        "port": [5228, 5229, 5230],
        "outbound": "direct"
      },
      {
        "network": "udp",
        "port": [443],
        "domain_suffix": [
          "google.com",
          "youtube.com",
          "googlevideo.com",
          "googleapis.com",
          "gstatic.com",
          "youtu.be",
          "ytimg.com"
        ],
        "action": "reject"
      },
      {
        "domain_suffix": [
          "google.com",
          "google.ru",
          "google.co.uk",
          "gmail.com",
          "googlemail.com",
          "googlevideo.com",
          "redirector.googlevideo.com",
          "youtube.com",
          "youtube.tv",
          "youtube-nocookie.com",
          "youtu.be",
          "ytimg.com",
          "i.ytimg.com",
          "ggpht.com",
          "gstatic.com",
          "googleapis.com",
          "youtubei.googleapis.com",
          "googleusercontent.com",
          "s.youtube.com",
          "withgoogle.com",
          "gvt1.com",
          "gvt2.com",
          "googleadservices.com",
          "googlesyndication.com",
          "google-analytics.com",
          "clients1.google.com",
          "play.googleapis.com",
          "android.googleapis.com",
          "gemini.google.com"
        ],
        "outbound": "vless-vps"
      },
      {
        "domain_keyword": ["googlevideo", "youtube", "ytimg", "ggpht", "gstatic", "gvt"],
        "outbound": "vless-vps"
      }
    ]
  }
}
