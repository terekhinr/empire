# Пример переменных окружения. Скопируйте: cp .env.example .env
# Заполните значения в .env; сам .env в git не добавляйте (см. .gitignore).

# --- Обязательные для бота / LLM ---
TELEGRAM_TOKEN=
OPENROUTER_API_KEY=
ADMIN_ID=

# --- База (по умолчанию sqlite в корне проекта) ---
DATABASE_URL=sqlite+aiosqlite:///empire.db

# --- Портфельный трекер (вкладка «Портфель» в dashboard) ---
# PORTFOLIO_DB=/root/projects/empire/portfolio.db
# PORTFOLIO_IMPORTS_DIR=/root/projects/empire/data/portfolio_imports
# PORTFOLIO_TBANK_TOKEN=           # read-only токен Т-Инвестиций → Настройки → API
# PORTFOLIO_TBANK_ACCOUNT_ID=      # опционально; иначе первый брокерский счёт
# PORTFOLIO_CUSHION_RUB=1500000      # несгораемая подушка в фондах ликвидности

# --- Опционально ---
# GDEPAR_CANONICAL_HOST=gdepar.ru  — абсолютные URL (canonical, OG, sitemap, robots)
# GDEPAR_SECURITY_HEADERS=0  — не добавлять middleware с X-Frame-Options и т.д. (локальная отладка)
# GET/HEAD https://<host>/api/gdepar/health — {"status":"ok"} для мониторинга
# Публичные GET /robots.txt и /sitemap.xml — SEO (sitemap: /, /map, /banya/{slug})
FAL_KEY=
# Веники Gdepar: Gemini Nano Banana (если ключ есть) или fal/flux
# GEMINI_API_KEY=
# GDEPAR_VENIK_IMAGE_PROVIDER=auto
# GDEPAR_VENIK_GEMINI_MODEL=gemini-2.5-flash-image
WEATHER_API_KEY=
NEWS_API_KEY=
BANYA_ADMIN_TOKEN=

# Идентификатор счётчика Яндекс.Метрики (только цифры). JavaScript-цели, имена как в коде:
# gdepar_session_start, gdepar_page_view, gdepar_hash_section (params.section, page),
# gdepar_popup_open, gdepar_reviews_open, gdepar_summary_request,
# gdepar_spot_click_out (params.kind), gdepar_phone_click, gdepar_spot_page_from_popup (params.spot_id), gdepar_spot_page_map_link (params.spot_id),
# gdepar_map_filter_submit, gdepar_home_filter_submit, gdepar_map_list_pick, gdepar_popup_full_map_link,
# gdepar_nav_click (params.dest), gdepar_home_cta (params.dest),
# gdepar_bayka_card_click (params.post_id), gdepar_contact_click (params.channel), gdepar_merch_interest (params.sku),
# gdepar_assistant_fab_click (params.action open|close), gdepar_assistant_open, gdepar_assistant_submit,
# gdepar_assistant_reply_ok, gdepar_assistant_reply_fail, gdepar_assistant_rate_limited
# GDEPAR_ASSISTANT_LOG=0  — не писать в лог серверные строки по POST /api/gdepar/assistant (см. gdepar.assistant)
# GDEPAR_ASSISTANT_RL_PER_MIN=24  — запросов с одного client_fp за скользящие 60 с (0 = без лимита)
# GDEPAR_ASSISTANT_RL_DISABLE=1  — отключить RL
# GDEPAR_ASSISTANT_LLM=0|1  — LLM помощника (нужен OPENROUTER_API_KEY)
# GDEPAR_ASSISTANT_LLM_PCT=100
# GDEPAR_ASSISTANT_CACHE_SECONDS=3600  — 0/off = кэш выкл.
# GDEPAR_POPUP_SUMMARY_LLM=0|1  — LLM для «Дай саммари» в попапе
# GDEPAR_POPUP_SUMMARY_LLM_PCT=100
# GDEPAR_HSTS_MAX_AGE=31536000  — HSTS на ответах приложения (прод за HTTPS)
# GDEPAR_ASSET_VERSION=20260520b  — query string для CSS/JS; bump при выкате шаблонов
# Помощник: POST /api/gdepar/assistant и POST /api/gdepar/assistant/stream (SSE)
# Логи латентности: journalctl -u empire_gdepar | grep 'timing route='
# Cookie gdepar_asst_sid — анонимная сессия для логов (HttpOnly, 30 дней)
# EMPIRE_SKIP_EMBEDDINGS=1  — в systemd unit уже задано для gdepar
# Метрика: gdepar.ru (empire_gdepar) и neverretire.ru (empire_webapp) — можно один ID или два счётчика
YANDEX_METRIKA_ID=

