# VK_WALL_PERSONAL_PENSION=1  — id1116951081 из PENSION_VK_URL
# VK_OWNER_PENSION=1116951081
# EMPIRE_DZEN_RSS_PENSION_PATH=media/rss_pension.xml  — URL: /rss/pension.xml
# VK_GROUP_GARDEN=  VK_GROUP_LENIN=  VK_GROUP_STERN=  VK_GROUP_GDEPAR=  VK_GROUP_PENSION=
# PENSION_TG_CHAT_ID=-1002257567806  — chat_id канала (или оставьте пустым: возьмётся @username из PENSION_TG_URL)
# VK_GROUP_ID=     — общий ID, если один на всех
# VC_RU_TOKEN=  MAX_API_TOKEN=
# YOUTUBE_API_KEY=
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_WEBHOOK_SECRET=   # заголовок X-Webhook-Secret → empire_sales
# EMPIRE_SALES_PORT=8002
# EMPIRE_SALES_DB=/root/projects/empire/sales.db
# EMPIRE_NPD_ANNUAL_LIMIT_RUB=2400000
# STERN_BOT_TOKEN=  — отдельный бот «Железная спина» (empire_stern_bot.py)
# DONATE_BOT_TOKEN=  — донат-бот ТОЛЬКО канала «Ленин» (empire_donate_bot.py)
# EMPIRE_DONATE_BOT_USERNAME=empire_lenin_donate_bot  — t.me/...?start=donate_lenin
# GARDEN_BOT_TOKEN=  — бот продаж «Сад и огород» (empire_garden_bot.py)
# EMPIRE_GARDEN_BOT_USERNAME=  — ссылки в автопостах канала
# EMPIRE_STARS_TO_RUB=1.8  — оценка ₽ для учёта в sales.db / лимит НПД
# BANYA_DAILY_MODERATE_AI=0
# BANYA_DAILY_MODERATE_BATCH=18
# BANYA_DAILY_MODERATE_MAX_BATCHES=4
# BANYA_DAILY_MODERATE_SOURCE=yandex
# BANYA_MODERATE_MODEL=openai/gpt-4o-mini

# --- Здоровье: Intervals.icu (Garmin → activities + wellness weight) ---
# INTERVALS_ICU_API_KEY=           # Settings → Developer → API key
# INTERVALS_ICU_ATHLETE_ID=i123456 # ID спортсмена на той же странице
# INTERVALS_ICU_DAYS_BACK=400      # глубина первой/регулярной выгрузки, дней

# --- Здоровье: Health Connect webhook (Lifesum + вес через Google Fit) ---
# HEALTH_INGEST_TOKEN=             # секрет для POST /api/health/ingest (заголовок X-Health-Token)
# URL в HC Webhook: https://neverretire.ru/api/health/ingest

# --- Empire Tasks PWA (planning_api, /tasks/) ---
# PLANNING_API_TOKEN=              # X-Planning-Token для API и PWA
# Web Push (напоминания при закрытом приложении):
#   ./venv/bin/python scripts/gen_planning_vapid_keys.py --write-env
# PLANNING_VAPID_PUBLIC_KEY=
# PLANNING_VAPID_PRIVATE_KEY=      # PEM одной строкой с \n
# PLANNING_VAPID_CONTACT=mailto:info@neverretire.ru
# Cron: scripts/cron/planning-push-reminders → /etc/cron.d/

# --- Безопаснее прод: вместо .env в каталоге репозитория ---
# systemd: EnvironmentFile=/etc/empire/empire.env и chmod 600 на файл;
# либо секреты в vault (Doppler, 1Password CLI) и export перед запуском.
